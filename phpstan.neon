includes:
    - vendor/pollora/harness/presets/phpstan/base.neon
    # Larastan is not included yet: it boots a Laravel application and this package's test stubs cannot be loaded with it

parameters:
    level: 6
    paths:
        - src
    ignoreErrors:
        # Pollora's services are read defensively, so that a tab survives an
        # older framework: method_exists() guards PHPStan cannot narrow on.
        - '#Call to function method_exists\(\) with .* will always evaluate to true#'
    reportUnmatchedIgnoredErrors: false
